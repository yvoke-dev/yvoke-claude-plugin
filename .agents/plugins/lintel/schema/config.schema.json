{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lintel Configuration",
  "description": "Lintel project configuration (.lintel/config.jsonc)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Path or URI to configuration JSON Schema"
    },
    "presets": {
      "type": "array",
      "description": "List of preset configurations to apply in order",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_-]+$"
      }
    },
    "paths": {
      "type": "object",
      "description": "Path pattern configurations and classification globs",
      "additionalProperties": false,
      "properties": {
        "tests": {
          "type": "object",
          "description": "Test groups mapping group names to pattern configurations",
          "patternProperties": {
            "^[a-z][a-z0-9-]*$": {
              "oneOf": [
                {
                  "type": "null",
                  "description": "Remove group from lower layers"
                },
                {
                  "type": "array",
                  "description": "List of test path globs",
                  "items": { "type": "string" }
                },
                {
                  "$ref": "#/definitions/testGroup"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "testOutput": {
          "$ref": "#/definitions/listOrAddRemove",
          "description": "Globs for untracked test output, compiled classes and caches"
        },
        "testReport": {
          "$ref": "#/definitions/listOrAddRemove",
          "description": "Globs for untracked test run reports (e.g. surefire-reports, JUnit XML)"
        },
        "build": {
          "$ref": "#/definitions/listOrAddRemove",
          "description": "Globs for build definition files (e.g. pom.xml, package.json)"
        },
        "source": {
          "$ref": "#/definitions/listOrAddRemove",
          "description": "Globs for source files and documentation"
        },
        "drift": {
          "$ref": "#/definitions/listOrAddRemove",
          "description": "Globs for test setup or config files matching source extensions that count as drift"
        }
      }
    },
    "permissions": {
      "type": "object",
      "description": "Mapping of persona roles or 'all' to assigned permissions",
      "additionalProperties": false,
      "properties": {
        "all": { "$ref": "#/definitions/listOrAddRemove" },
        "po": { "$ref": "#/definitions/listOrAddRemove" },
        "architect": { "$ref": "#/definitions/listOrAddRemove" },
        "qa": { "$ref": "#/definitions/listOrAddRemove" },
        "dev": { "$ref": "#/definitions/listOrAddRemove" },
        "po-reviewer": { "$ref": "#/definitions/listOrAddRemove" },
        "architect-reviewer": { "$ref": "#/definitions/listOrAddRemove" },
        "qa-reviewer": { "$ref": "#/definitions/listOrAddRemove" },
        "dev-reviewer": { "$ref": "#/definitions/listOrAddRemove" },
        "final-reviewer": { "$ref": "#/definitions/listOrAddRemove" }
      }
    },

    "skills": {
      "type": "object",
      "description": "Mapping of persona roles or 'all' to assigned skills",
      "additionalProperties": false,
      "properties": {
        "all": { "$ref": "#/definitions/listOrAddRemove" },
        "po": { "$ref": "#/definitions/listOrAddRemove" },
        "po-reviewer": { "$ref": "#/definitions/listOrAddRemove" },
        "architect": { "$ref": "#/definitions/listOrAddRemove" },
        "architect-reviewer": { "$ref": "#/definitions/listOrAddRemove" },
        "qa": { "$ref": "#/definitions/listOrAddRemove" },
        "qa-reviewer": { "$ref": "#/definitions/listOrAddRemove" },
        "dev": { "$ref": "#/definitions/listOrAddRemove" },
        "dev-reviewer": { "$ref": "#/definitions/listOrAddRemove" },
        "arbiter": { "$ref": "#/definitions/listOrAddRemove" },
        "final-reviewer": { "$ref": "#/definitions/listOrAddRemove" }
      }
    },
    "steering": {
      "type": "object",
      "description": "Mapping of persona roles or 'all' to steering files in .lintel/steering/",
      "additionalProperties": false,
      "properties": {
        "all": { "$ref": "#/definitions/listOrAddRemove" },
        "po": { "$ref": "#/definitions/listOrAddRemove" },
        "po-reviewer": { "$ref": "#/definitions/listOrAddRemove" },
        "architect": { "$ref": "#/definitions/listOrAddRemove" },
        "architect-reviewer": { "$ref": "#/definitions/listOrAddRemove" },
        "qa": { "$ref": "#/definitions/listOrAddRemove" },
        "qa-reviewer": { "$ref": "#/definitions/listOrAddRemove" },
        "dev": { "$ref": "#/definitions/listOrAddRemove" },
        "dev-reviewer": { "$ref": "#/definitions/listOrAddRemove" },
        "arbiter": { "$ref": "#/definitions/listOrAddRemove" },
        "final-reviewer": { "$ref": "#/definitions/listOrAddRemove" }
      }
    },
    "personas": {
      "type": "object",
      "description": "Mapping of persona roles to persona markdown files in .lintel/personas/",
      "additionalProperties": false,
      "properties": {
        "po": { "type": "string" },
        "po-reviewer": { "type": "string" },
        "architect": { "type": "string" },
        "architect-reviewer": { "type": "string" },
        "qa": { "type": "string" },
        "qa-reviewer": { "type": "string" },
        "dev": { "type": "string" },
        "dev-reviewer": { "type": "string" },
        "arbiter": { "type": "string" },
        "final-reviewer": { "type": "string" }
      }
    },
    "workflow": {
      "type": "object",
      "description": "Workflow thresholds and execution limits",
      "additionalProperties": false,
      "properties": {
        "maxRounds": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum review rounds before escalating (default 25)"
        },
        "stallRounds": {
          "type": "integer",
          "minimum": 1,
          "description": "Review rounds without progress before declaring a stall (default 3)"
        },
        "testTimeoutSeconds": {
          "type": "number",
          "minimum": 1,
          "description": "Default test execution timeout in seconds (default 900)"
        }
      }
    }
  },
  "definitions": {
    "listOrAddRemove": {
      "oneOf": [
        {
          "type": "array",
          "items": { "type": "string" }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "add": {
              "type": "array",
              "items": { "type": "string" }
            },
            "remove": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      ]
    },
    "testGroup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paths": {
          "$ref": "#/definitions/listOrAddRemove",
          "description": "List of test path globs or add/remove operations"
        },
        "required": {
          "type": "boolean",
          "description": "Whether this test group is required in test outlines"
        },
        "timeoutSeconds": {
          "type": "number",
          "minimum": 1,
          "description": "Per-group test execution timeout in seconds"
        }
      }
    }
  }
}
